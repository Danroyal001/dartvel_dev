[Unit]
Description=dartvel.dev (Dartvel web-server binary)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=sigmadev
Group=sigmadev
WorkingDirectory=/srv/dartvel.dev
EnvironmentFile=/srv/dartvel.dev/env
ExecStart=/srv/dartvel.dev/current/server
Restart=always
RestartSec=2
# The binary writes only its data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/dartvel.dev/data
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
